# Hunch — environment. Copy to .env.local and fill in. Never commit real values.
# Everything runs locally without the provider keys: missing providers fall back
# to local adapters in demo/test, and fail loudly in production/staging.

# ---------------------------------------------------------------- app
# production | staging | test | demo
APP_PROFILE=demo
APP_URL=http://localhost:3000
LOG_LEVEL=info
# 32+ random bytes (openssl rand -base64 48). Signs local dev sessions and
# internal requests from the worker.
SESSION_SECRET=

# ----------------------------------------------------------- database
# Local: native Postgres. Supabase: DATABASE_URL = transaction pooler (port 6543),
# DIRECT_URL = direct connection (port 5432) for migrations and the worker.
DATABASE_URL=postgres://localhost:5432/hunch_dev
DIRECT_URL=postgres://localhost:5432/hunch_dev

# ----------------------------------------------------------- supabase
# Project settings → API. Auth providers: enable Google (OAuth client from
# Google Cloud) and Web3 (Solana, Ethereum).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# -------------------------------------------------------------- privy
# Embedded self-custodial wallets, created on first login. In the Privy
# dashboard, set custom auth (JWT) to the Supabase JWKS:
#   https://<project>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The native apps' Privy client (dashboard → Clients): allowed app identifier
# xyz.tryimo.app, URL scheme imo.
PRIVY_MOBILE_CLIENT_ID=

# Trading: "wallet" (real money: the trader's wallet signs venue transactions)
# or "paper". Unset: wallet in production/staging, paper elsewhere.
# TRADING=
# Solana RPC for wallet balances; the public endpoint is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------- venues
# Venue hosts adapters may call (comma-separated). Anything else is refused.
# Providers you configure (Supabase, Privy, Resend, Upstash, Sentry, PostHog)
# are allowed automatically.
EGRESS_ALLOW=gamma-api.polymarket.com,clob.polymarket.com,data-api.polymarket.com,external-api.kalshi.com,external-api.demo.kalshi.co,api.jup.ag
# demo | production. Production needs Kalshi's written data consent first
# (apply at https://kalshi.com/builders). Market data is public: no key needed.
KALSHI_ENV=demo
# Live feeds to run (comma-separated source ids): kalshi-direct, polymarket-public,
# jupiter-predict. Unset: demo → the design dataset; production → all three.
# DATA_SOURCES=polymarket-public,jupiter-predict
# Jupiter Predict (developers.jup.ag/portal). Optional: reads work without a key,
# but at a low rate; a key raises it.
JUPITER_API_KEY=
# Only for trading through Kalshi's API later (not used by paper trading).
KALSHI_API_KEY_ID=
# RSA private key (PEM, newlines as \n)
KALSHI_PRIVATE_KEY=

# -------------------------------------------------------------- cache
# Optional: quotes and rate budgets shared across instances. Postgres is used
# without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------------------------------------------------------------- email
RESEND_API_KEY=
EMAIL_FROM="Hunch <hello@example.com>"

# ------------------------------------------------------ observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------ paper trading
# Starting balance in whole dollars.
PAPER_STARTING_BALANCE=10000
# Multiplies the per-person API rate budgets (load tests; leave at 1).
# API_RATE_SCALE=1

# --- Admins -----------------------------------------------------------------
# Verified sign-in emails that get the admin role on first sign-in (comma
# separated). Or promote someone later: npx tsx scripts/make-admin.ts <handle>
ADMIN_EMAILS=

# --- Storage -----------------------------------------------------------------
# Supabase Storage bucket for avatars and evidence images (public bucket).
SUPABASE_STORAGE_BUCKET=media
# Without Supabase (local demo, self-hosting), uploads live on disk here.
LOCAL_STORAGE_DIR=.data/uploads
