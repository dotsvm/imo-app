{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@imo/core/*": [
        "./packages/core/src/*"
      ],
      "@imo/venues/*": [
        "./packages/venues/src/*"
      ],
      "@imo/domain/*": [
        "./packages/domain/src/*"
      ],
      "@imo/server/*": [
        "./packages/server/src/*"
      ]
    }
  }
}
